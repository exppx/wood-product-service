    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "react-router": "^8.4.0",
    "ress": "^6.0.0",
    "sass": "^1.104.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.2",
